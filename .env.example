# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=antigravity_master_secret_key_change_in_production_9f82b7c61d5e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary: PostgreSQL. If unreachable or not configured, the system automatically falls back to SQLite.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_ai
# SQLite fallback path:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./platform.db

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_EMBED_MODEL=all-minilm

# Local Vector Storage (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=document_rag_collection

# File Storage Directories
UPLOAD_DIR=./storage/uploads
GENERATED_DIR=./storage/generated
MAX_UPLOAD_SIZE_MB=50

# Web Research
SEARCH_ENGINE=duckduckgo
MAX_SEARCH_RESULTS=5
